            if required:
                warn("بدون map باید یک آدرس socks5 بدهید.")
                continue
            return ""
        if valid_endpoint(value, bind=True):
            return value
        warn("socks5 را مثل 127.0.0.1:1080 بنویسید.")


def ask_targets() -> list:
    targets = []
    print("  allowed_targets: مقصدهایی که client اجازه دارد به آن‌ها وصل شود.")
    print("  خالی همه‌چیز را می‌بندد. * یعنی بدون محدودیت.")
    while True:
        default = "127.0.0.1:8080" if not targets else ""
        value = ask("allowed_targets", default)
        if targets and value == "":
            return targets
        if value != "*" and not valid_endpoint(value, bind=False):
            warn("مقصد را مثل 127.0.0.1:8080 یا * بنویسید.")
            continue
        targets.append(value)
        if not ask_yes("مقصد دیگر", False):
            return targets


def pool_value(role: str, transport: str, reverse: bool, forwarding: str) -> int:
    client_pool = role == "client" or (role == "server" and reverse)
    must_be_one = (
        forwarding != "ports"
        or transport in RAW_TRANSPORTS
        or (role == "client" and reverse)
    )
    if not client_pool or must_be_one:
        print("  connection_pool: 1")
        if role == "server" and not reverse:
            print("  اندازه pool را روی client تنظیم کنید.")
        return 1
    return ask_int("connection_pool", 1, 1, 16)


