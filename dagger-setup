def configure_stdio() -> None:
    for stream in (sys.stdout, sys.stderr):
        reconfigure = getattr(stream, "reconfigure", None)
        if reconfigure is None:
            continue
        try:
            reconfigure(encoding="utf-8", errors="replace")
        except (OSError, ValueError):
            pass


def open_terminal():
    try:
        return open("/dev/tty", "r", encoding="utf-8", errors="replace")
    except OSError:
        pass
    stdin = sys.stdin
    isatty = getattr(stdin, "isatty", None)
    if isatty is not None and isatty():
        return stdin
    return None


def emit(text: str) -> None:
    sys.stdout.write(text)
    sys.stdout.flush()


def fit(text: str, width: int) -> str:
    if len(text) <= width:
        return text
    if width <= 1:
        return text[:width]
    return text[: width - 1] + "…"


def cooked() -> None:
    if FD is None or ORIG is None:
        return
    import termios

    termios.tcsetattr(FD, termios.TCSADRAIN, ORIG)


def cbreak() -> None:
    import termios
    import tty

    # TCSANOW keeps keystrokes already typed. The default flush would drop them.
    tty.setcbreak(FD, termios.TCSANOW)


def show_cursor() -> None:
    emit("\033[?25h")


def enter_screen() -> None:
    global SCREEN
    emit("\033[?1049h\033[2J\033[H")
    SCREEN = True


def leave_screen() -> None:
    global SCREEN
    if not SCREEN:
        return
    try:
        cooked()
    except Exception:
        pass
    try:
        emit("\033[0m\033[?25h\033[?1049l")
    except Exception:
        pass
    SCREEN = False


def open_form(title: str) -> None:
    show_cursor()
    try:
        cooked()
    except Exception:
        pass
    emit("\033[2J\033[H")
    text = fit(f" dagger-rs   {title}", WIDTH)
    emit(HEAD + text + " " * (WIDTH - len(text)) + RESET + "\n")
    emit(BOX + "─" * WIDTH + RESET + "\n\n")


def take_available(count: int) -> bytes:
    global PENDING
    if PENDING:
        chunk = PENDING[:count]
        PENDING = PENDING[count:]
        return chunk
    try:
        return os.read(FD, count)
    except OSError:
        return b""


def wait_input(timeout: float) -> bool:
    if PENDING:
        return True
    import select

    return bool(select.select([FD], [], [], timeout)[0])


def read_line(prompt: str) -> str:
    global PENDING
    show_cursor()
    try:
        cooked()
    except Exception:
        pass
    emit(prompt)
    if FD is None:
        emit("\n")
        raise SystemExit(0)
    while b"\n" not in PENDING and b"\r" not in PENDING:
        try:
            piece = os.read(FD, 256)
        except OSError:
            piece = b""
        if piece == b"":
            if not PENDING:
                emit("\n")
                raise SystemExit(0)
            break
        PENDING += piece
    for sep in (b"\r\n", b"\n", b"\r"):
        if sep in PENDING:
            line, _, PENDING = PENDING.partition(sep)
            return line.decode("utf-8", "replace")
    line, PENDING = PENDING, b""
    return line.decode("utf-8", "replace")


def warn(message: str) -> None:
    emit(f"{ERR}  ! {message}{RESET}\n")


def section(title: str) -> None:
    emit(f"{SEC}  {title}{RESET}\n")


def pause() -> None:
    read_line(f"{DIM}  Press Enter to return to the menu.{RESET} ")


def ask(label: str, default=None) -> str:
    if default is None:
        prompt = f"{LABEL}  {label}{RESET}: "
        use_default = False
    else:
        prompt = f"{LABEL}  {label}{RESET} {DIM}[{default}]{RESET}: "
        use_default = True
    value = read_line(prompt)
    if value.strip() == "" and use_default:
        return str(default)
    return value.strip()


def draw_choices(title: str, options: list, index: int, notice: str, allow_cancel: bool, preamble: str) -> None:
    lines = ["\033[2J\033[H\033[?25l"]
    text = fit(f" dagger-rs   {title}", WIDTH)
    lines.append(HEAD + text + " " * (WIDTH - len(text)) + RESET + "\n")
    lines.append(BOX + "─" * WIDTH + RESET + "\n")
    if preamble:
        lines.append("\n")
        for raw in preamble.splitlines():
            lines.append("  " + fit(raw, WIDTH - 2) + "\n")
    lines.append("\n")
    lines.append(f"{BOX}┌{'─' * INNER}┐{RESET}\n")
    for number, (_value, label) in enumerate(options, start=1):
        mark = "▸ " if number - 1 == index else "  "
        row = f"{mark}{number:<2}  {label}"
        if number - 1 == index:
            lines.append(box_row(row, SEL))
        else:
            lines.append(box_row(row))
    lines.append(f"{BOX}└{'─' * INNER}┘{RESET}\n")
    hint = "  ↑↓ move     Enter select     number chooses"
    if allow_cancel:
        hint += "     0 back"
    lines.append(DIM + fit(hint, WIDTH) + RESET + "\n")
    if notice:
        lines.append(ERR + fit("  " + notice, WIDTH) + RESET + "\n")
    else:
        lines.append("\n")
    emit("".join(lines))


def choose(title: str, options: list, default: int = 0, allow_cancel: bool = False, preamble: str = ""):
    index = default if 0 <= default < len(options) else 0
    notice = ""
    while True:
        draw_choices(title, options, index, notice, allow_cancel, preamble)
        key = read_key()
        notice = ""
        if key == "eof":
            raise SystemExit(0)
        if key == "exit":
            if allow_cancel:
                return None
            notice = "That number is not in the list."
            continue
        if key == "up":
            index = (index - 1) % len(options)
        elif key == "down":
            index = (index + 1) % len(options)
        elif key == "enter":
            return options[index][0]
        elif key.startswith("run:") or key.startswith("num:"):
            number = key.split(":", 1)[1]
            if not number.isdigit():
                notice = "That number is not in the list."
                continue
            picked = int(number, 10) - 1
            if not 0 <= picked < len(options):
                notice = "That number is not in the list."
                continue
            if key.startswith("run:"):
                return options[picked][0]
            index = picked
        elif key == "bad":
            notice = "Use ↑↓ or a number from the list."


def choose_yes(title: str, default: bool = False, preamble: str = "") -> bool:
    result = choose(
        title,
        [(True, "Yes"), (False, "No")],
        default=0 if default else 1,
        preamble=preamble,
    )
    return bool(result)


def ask_yes(label: str, default: bool = False) -> bool:
