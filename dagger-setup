def write_config(role: str, config: dict) -> None:
    destination = CONFIG / f"{role}.json"
    handle, temporary_name = tempfile.mkstemp(prefix=".config.", dir=str(CONFIG))
    os.close(handle)
    temporary = Path(temporary_name)
    try:
        temporary.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
        chmod_private(temporary)
        if run_bin(["--config", str(temporary), "--check"]) != 0:
            warn("dagger-rs --check این تنظیم را نپذیرفت. فایل قبلی ماند.")
            return
        if destination.exists():
            backup = CONFIG / f"{role}.json.backup.{time.time_ns()}"
            shutil.copy2(destination, backup)
            print(f"  نسخه قبلی: {backup.name}")
        os.replace(temporary, destination)
        temporary = None
        chmod_private(destination)
        claim_files(role, destination)
        print(f"  ذخیره شد: {destination}")
    finally:
        if temporary is not None and temporary.exists():
            temporary.unlink()


def claim_files(role: str, config_path: Path) -> None:
    if not is_root():
        return
    if shutil.which("id") is None:
        return
    probe = subprocess.run(["id", "dagger-rs"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if probe.returncode != 0:
        return
    targets = [CONFIG, config_path, CONFIG / f"{role}-keys", CONFIG / f"{role}-tls"]
    for directory in (CONFIG / f"{role}-keys", CONFIG / f"{role}-tls"):
        if not directory.is_dir():
            continue
        for name in ("private.key", "public.key", "cert.pem", "key.pem", "ca.pem"):
            item = directory / name
            if item.is_file():
                targets.append(item)
    for target in targets:
        if target.exists():
            subprocess.run(["chown", "dagger-rs:dagger-rs", str(target)])


