def ask_int(label: str, default: int, low: int, high: int) -> int:
    while True:
        raw = ask(label, str(default))
        if re.fullmatch(r"[0-9]+", raw):
            number = int(raw, 10)
            if low <= number <= high:
                return number
        warn(f"Type a number from {low} to {high}.")


