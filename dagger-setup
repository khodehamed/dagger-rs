def privileged_bind(config: dict) -> bool:
    binds = []
    if config.get("mode") == "server":
        for listener in config.get("listeners", []):
            for item in listener.get("maps", []):
                binds.append(item.get("bind", ""))
            if listener.get("raw") is None and not config.get("reverse"):
                binds.append(listener.get("addr", ""))
        if config.get("socks5"):
            binds.append(config["socks5"])
    elif config.get("reverse"):
        for path in config.get("paths", []):
            binds.append(path.get("addr", ""))
    for value in binds:
        parsed = split_endpoint(str(value))
        if parsed is None or not parsed[1].isdigit():
            continue
        port = int(parsed[1], 10)
        if 0 < port < 1024:
            return True
    return False


def install_service() -> None:
    if shutil.which("systemctl") is None:
        warn("systemd در دسترس نیست.")
        pause()
        return
    role = ask_role()
    if role is None:
        return
    path = config_path(role)
    if path is None:
        pause()
        return
    if run_bin(["--config", str(path), "--check"]) != 0:
        warn("تا وقتی --check قبول نکند سرویس نصب نمی‌شود.")
        pause()
        return
    config = load_json(path)
    has_tun = config.get("tun") is not None
    endpoints = list(config.get("listeners", [])) + list(config.get("paths", []))
    has_raw = any(item.get("raw") is not None for item in endpoints)
    has_low = privileged_bind(config)
    if (has_tun or has_raw or has_low) and not is_root():
        warn("این تنظیم قابلیت سیستمی می‌خواهد. نصب سرویس را با root انجام دهید.")
        pause()
        return
    caps = []
    families = ["AF_INET", "AF_INET6", "AF_UNIX"]
    if has_tun:
        caps.append("CAP_NET_ADMIN")
        families.append("AF_NETLINK")
    if has_raw:
        caps.append("CAP_NET_RAW")
        families.append("AF_PACKET")
        if not has_tun:
            families.append("AF_NETLINK")
    if has_low:
        caps.append("CAP_NET_BIND_SERVICE")
    capability = ""
    if caps:
        joined = " ".join(caps)
        capability = f"AmbientCapabilities={joined}\nCapabilityBoundingSet={joined}"
    if is_root():
        units = Path("/etc/systemd/system")
        if shutil.which("id") and subprocess.run(
            ["id", "dagger-rs"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        ).returncode != 0:
            if shutil.which("useradd") is None or subprocess.run(
                [
                    "useradd",
                    "--system",
                    "--no-create-home",
                    "--home-dir",
                    str(CONFIG),
                    "--shell",
                    "/usr/sbin/nologin",
                    "dagger-rs",
                ]
            ).returncode != 0:
                warn("کاربر سیستمی dagger-rs ساخته نشد.")
                pause()
                return
        claim_files(role, path)
        if shutil.which("runuser") is None or subprocess.run(
            ["runuser", "-u", "dagger-rs", "--", BINARY, "--config", str(path), "--check"]
        ).returncode != 0:
            warn("کاربر سرویس نمی‌تواند تنظیم یا کلید را بخواند.")
            pause()
            return
        user_line = "User=dagger-rs"
        wanted = "multi-user.target"
    else:
        xdg = os.environ.get("XDG_CONFIG_HOME")
        base = Path(xdg) if xdg else Path.home() / ".config"
        units = base / "systemd" / "user"
        user_line = ""
        wanted = "default.target"
    units.mkdir(parents=True, exist_ok=True)
    unit_path = units / f"dagger-rs-{role}.service"
    body = [
        "[Unit]",
        f"Description=Independent Rust reverse tunnel ({role})",
        "After=network-online.target",
        "Wants=network-online.target",
        "",
        "[Service]",
        "Type=simple",
    ]
    if user_line:
        body.append(user_line)
    body.extend(
        [
            f'ExecStart="{BINARY}" --config "{path}"',
            "Restart=on-failure",
            "RestartSec=3",
            "TimeoutStopSec=10",
            "UMask=0077",
            "NoNewPrivileges=true",
        ]
    )
    if capability:
        body.extend(capability.splitlines())
    body.extend(
        [
            "PrivateTmp=true",
            "ProtectSystem=strict",
            "ProtectHome=read-only",
            "RestrictAddressFamilies=" + " ".join(families),
            "",
            "[Install]",
            f"WantedBy={wanted}",
            "",
        ]
    )
    unit_path.write_text("\n".join(body), encoding="utf-8")
    try:
        os.chmod(unit_path, 0o644)
    except OSError:
        pass
    if systemctl(["daemon-reload"]) != 0:
        warn("daemon-reload ناموفق بود.")
        pause()
        return
    if systemctl(["enable", "--now", f"dagger-rs-{role}.service"]) != 0:
        warn("روشن کردن سرویس ناموفق بود.")
        pause()
        return
    print(f"  سرویس dagger-rs-{role}.service روشن و برای بوت فعال شد.")
    if not is_root():
        print("  سرویس کاربر با بستن نشست ممکن است بایستد، مگر lingering روشن باشد.")
    pause()


