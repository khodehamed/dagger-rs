def configure_stdio() -> None:
    for stream in (sys.stdout, sys.stderr):
        reconfigure = getattr(stream, "reconfigure", None)
        if reconfigure is None:
            continue
        try:
            reconfigure(encoding="utf-8", errors="replace")
        except (OSError, ValueError):
            pass


def open_terminal():
    try:
        return open("/dev/tty", "r", encoding="utf-8", errors="replace")
    except OSError:
        pass
    stdin = sys.stdin
    isatty = getattr(stdin, "isatty", None)
    if isatty is not None and isatty():
        return stdin
    return None


def emit(text: str) -> None:
    sys.stdout.write(text)
    sys.stdout.flush()


def fit(text: str, width: int) -> str:
    if len(text) <= width:
        return text
    if width <= 1:
        return text[:width]
    return text[: width - 1] + "…"


def cooked() -> None:
    if FD is None or ORIG is None:
        return
    import termios

    termios.tcsetattr(FD, termios.TCSADRAIN, ORIG)


def cbreak() -> None:
    import termios
    import tty

    tty.setcbreak(FD)


def show_cursor() -> None:
    emit("\033[?25h")


def enter_screen() -> None:
    global SCREEN
    emit("\033[?1049h\033[2J\033[H")
    SCREEN = True


def leave_screen() -> None:
    global SCREEN
    if not SCREEN:
        return
    try:
        cooked()
    except Exception:
        pass
    try:
        emit("\033[0m\033[?25h\033[?1049l")
    except Exception:
        pass
    SCREEN = False


def open_form(title: str) -> None:
    show_cursor()
    try:
        cooked()
    except Exception:
        pass
    emit("\033[2J\033[H")
    text = fit(f" dagger-rs   {title}", WIDTH)
    emit(HEAD + text + " " * (WIDTH - len(text)) + RESET + "\n")
    emit(BOX + "─" * WIDTH + RESET + "\n\n")


def read_line(prompt: str) -> str:
    show_cursor()
    try:
        cooked()
    except Exception:
        pass
    emit(prompt)
    if FD is None:
        emit("\n")
        raise SystemExit(0)
    chunks = []
    while True:
        try:
            piece = os.read(FD, 256)
        except OSError:
            piece = b""
        if piece == b"":
            emit("\n")
            raise SystemExit(0)
        chunks.append(piece)
        if b"\n" in piece or b"\r" in piece:
            break
    raw = b"".join(chunks)
    return raw.split(b"\r", 1)[0].split(b"\n", 1)[0].decode("utf-8", "replace")


def warn(message: str) -> None:
    emit(f"{ERR}  ! {message}{RESET}\n")


def section(title: str) -> None:
    emit(f"{SEC}  {title}{RESET}\n")


def pause() -> None:
    read_line(f"{DIM}  Enter برای بازگشت به منو.{RESET} ")


def ask(label: str, default=None) -> str:
    if default is None:
        prompt = f"{LABEL}  {label}{RESET}: "
        use_default = False
    else:
        prompt = f"{LABEL}  {label}{RESET} {DIM}[{default}]{RESET}: "
        use_default = True
    value = read_line(prompt)
    if value.strip() == "" and use_default:
        return str(default)
    return value.strip()


def ask_yes(label: str, default: bool = False) -> bool:
    shown = "yes" if default else "no"
    while True:
        value = ask(f"{label} (yes/no)", shown).lower()
        if value in ("yes", "y"):
            return True
        if value in ("no", "n"):
            return False
        warn("yes یا no بنویسید.")


def ask_int(label: str, default: int, low: int, high: int) -> int:
    while True:
        raw = ask(label, str(default))
        if re.fullmatch(r"[0-9]+", raw):
            number = int(raw, 10)
            if low <= number <= high:
                return number
        warn(f"یک عدد از {low} تا {high} بنویسید.")


def ask_role():
    emit(f"{SEC}  نقش: server (شنونده) یا client (وصل‌شونده){RESET}\n")
    emit(f"{DIM}  خالی = بازگشت به منو{RESET}\n")
    while True:
        value = ask("server/client").lower()
        if value == "":
            return None
        if value in ("server", "client"):
            return value
        warn("فقط server یا client.")


def is_root() -> bool:
    geteuid = getattr(os, "geteuid", None)
    return bool(geteuid and geteuid() == 0)


def assert_safe(path: Path) -> None:
    text = str(path)
    if re.search(r"[\x00-\x1f]", text) or any(char in text for char in '"%$'):
        print("مسیر نویسه غیرمجاز دارد.", file=sys.stderr)
        raise SystemExit(2)


def default_config_dir() -> Path:
    env = os.environ.get("DAGGER_CONFIG_DIR")
    if env:
        return Path(env)
    if is_root():
        return Path("/etc/dagger-rs")
    xdg = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg) if xdg else Path.home() / ".config"
    return base / "dagger-rs"


def prepare_config_dir() -> Path:
    path = default_config_dir().expanduser().resolve()
    assert_safe(path)
    home = str(Path.home().resolve()) if Path.home().exists() else ""
    forbidden = {
        "/",
        "/etc",
        "/usr",
        "/usr/local",
        "/var",
        "/home",
        "/root",
        "/opt",
        "/tmp",
        home,
    }
    if str(path) in forbidden:
        print("یک پوشه اختصاصی برای تنظیمات انتخاب کنید.", file=sys.stderr)
        raise SystemExit(2)
    path.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(path, 0o700)
    except OSError:
        pass
    return path


def find_binary() -> str:
    candidates = []
    env = os.environ.get("DAGGER_BIN")
    if env:
        candidates.append(env)
    else:
        found = shutil.which("dagger-rs")
        if found:
            candidates.append(found)
        candidates.append("/usr/local/bin/dagger-rs")
    for item in candidates:
        candidate = Path(item)
        if candidate.is_file():
            assert_safe(candidate)
            return str(candidate)
    print("فایل dagger-rs پیدا نشد. اول نصب را انجام دهید.", file=sys.stderr)
    raise SystemExit(1)


def split_endpoint(value: str):
    if any(char.isspace() for char in value) or not value or len(value) > 1024:
        return None
    if value.startswith("["):
        rest = value[1:]
        if "]" not in rest:
            return None
        host, after = rest.split("]", 1)
        if not after.startswith(":") or not host:
            return None
        return host, after[1:], True
    if value.count(":") != 1:
        return None
    host, port = value.split(":", 1)
    if not host:
        return None
    return host, port, False


def valid_endpoint(value: str, bind: bool = False, ipv6: bool = False) -> bool:
    parsed = split_endpoint(value)
    if parsed is None:
        return False
    host, port, bracket = parsed
    if not port.isdigit():
        return False
    number = int(port, 10)
    if not 1 <= number <= 65535:
        return False
    if ipv6 or bracket:
        try:
            ipaddress.IPv6Address(host)
        except ValueError:
            return False
        return True
    if bind:
        try:
            ipaddress.ip_address(host)
        except ValueError:
            return False
        return True
    if re.fullmatch(r"[A-Za-z0-9.-]+", host) is None:
        return False
    if host.startswith("-") or host.endswith("-") or ".." in host:
        return False
    return True


def ask_addr(label: str, default: str, bind: bool, ipv6: bool) -> str:
    while True:
        value = ask(label, default)
        if valid_endpoint(value, bind=bind, ipv6=ipv6):
            return value
        if ipv6:
            warn("برای dc6 آدرس [IPv6]:port بنویسید.")
        elif bind:
            warn("آدرس IP:port بنویسید. IPv6 با براکت: [2001:db8::1]:7000")
        else:
            warn("آدرس را مثل host:port یا [IPv6]:port بنویسید.")


def valid_key(value: str) -> bool:
    return bool(re.fullmatch(r"[0-9a-fA-F]{64}", value)) and set(value.lower()) != {"0"}


def chmod_private(path: Path) -> None:
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def run_bin(args: list[str], stdin=None) -> int:
    completed = subprocess.run([BINARY, *args], stdin=stdin)
    return completed.returncode


def ensure_keys(role: str) -> bool:
    directory = CONFIG / f"{role}-keys"
    private = directory / "private.key"
    public = directory / "public.key"
    if private.is_file():
        print(f"  کلید {role} از قبل هست. ساخته نشد.")
    else:
        directory.mkdir(parents=True, exist_ok=True)
        code = run_bin(["keygen", "--out", str(directory)])
        if code != 0 or not public.is_file():
            warn("ساخت کلید ناموفق بود.")
            return False
        chmod_private(private)
    if public.is_file():
        text = public.read_text(encoding="utf-8", errors="replace").strip()
        print("  کلید عمومی (فقط همین را برای طرف مقابل بفرستید):")
        print(f"  {text}")
        print("  private.key روی همین دستگاه می‌ماند.")
    return public.is_file()


def place_file(src: str, dest: Path, secret: bool = False) -> bool:
    source = Path(src)
    if not source.is_file():
        return False
    dest.parent.mkdir(parents=True, exist_ok=True)
    same = dest.exists() and source.resolve() == dest.resolve()
    if not same:
        shutil.copyfile(source, dest)
    if secret:
        chmod_private(dest)
    return True


def valid_authority(value: str) -> bool:
    if not value or len(value) > 253:
        return False
    return re.fullmatch(r"(\[[0-9a-fA-F:]+\]|[A-Za-z0-9.-]+)(:[0-9]+)?", value) is not None


def authority_name(authority: str) -> str:
    if authority.startswith("["):
        return authority[1:].split("]", 1)[0]
    return authority.split(":", 1)[0]


def presents_certificate(role: str, reverse: bool) -> bool:
    if reverse:
        return role == "client"
    return role == "server"


