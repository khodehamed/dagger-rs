def ask_xhttp(role: str, reverse: bool) -> dict:
    default_mode = "packet-up" if reverse else "stream-up"
    if reverse:
        if role == "server":
            print("  این server منطقی به HTTP edge وصل می‌شود. map و socks همین‌جا می‌مانند.")
        else:
            print("  این client منطقی به‌عنوان origin گوش می‌دهد. allowed_targets همین‌جا می‌ماند.")
    while True:
        mode = ask("xhttp mode (stream-up/packet-up/auto)", default_mode)
        if mode in ("stream-up", "packet-up", "auto"):
            break
        warn("stream-up یا packet-up یا auto.")
    options = {"mode": mode}
    dialer = (role == "client" and not reverse) or (role == "server" and reverse)
    if dialer:
        while True:
            host = ask("HTTP Host / TLS SNI (خالی = آدرس همتا)", "")
            if host and not valid_authority(host):
                warn("یک نام میزبان یا IP، شاید با پورت، بنویسید.")
                continue
            if reverse and not host:
                warn("در reverse نام دامنه‌ای که به origin می‌رسد لازم است.")
                continue
            if host:
                options["host"] = host
            break
    return options


def ask_tls(role: str, transport: str, reverse: bool, authority: str) -> dict:
    directory = CONFIG / f"{role}-tls"
    directory.mkdir(parents=True, exist_ok=True)
    fields = {}
    if presents_certificate(role, reverse):
        while True:
            certificate = ask("فایل cert.pem سرور")
            key = ask("فایل key.pem سرور")
            if place_file(certificate, directory / "cert.pem") and place_file(
                key, directory / "key.pem", secret=True
            ):
                break
            warn("هر دو فایل PEM باید وجود داشته باشند.")
        fields["cert_file"] = f"{role}-tls/cert.pem"
        fields["key_file"] = f"{role}-tls/key.pem"
        return fields
    if transport == "xhttps" and authority:
        name = authority_name(authority)
        print(f"  TLS نام را از Host می‌گیرد: {name}")
    else:
        while True:
            name = ask("TLS server_name (نام گواهی)")
            if re.fullmatch(r"[A-Za-z0-9_.:-]+", name or ""):
                break
            warn("نام TLS نامعتبر است.")
    while True:
        certificate = ask("فایل PEM اعتماد (ca_file)")
        if place_file(certificate, directory / "ca.pem"):
            break
        warn("فایل گواهی اعتماد پیدا نشد.")
    fields["server_name"] = name
    fields["ca_file"] = f"{role}-tls/ca.pem"
    return fields


def valid_ipv4(value: str, allow_empty: bool = False) -> bool:
    if value == "":
        return allow_empty
    try:
        address = ipaddress.IPv4Address(value)
    except ValueError:
        return False
    if address.is_unspecified or address.is_multicast or int(address) == 0xFFFFFFFF:
        return False
    return True


def ask_raw(role: str) -> dict:
    print("  بسته خام: peer واقعی، اینترفیس و پورت بیرونی.")
    while True:
        profile = ask("raw profile (tcp/udp/icmp/gre/ipip/bip/raw)", "tcp")
        if profile in ("tcp", "udp", "icmp", "gre", "ipip", "bip", "raw"):
            break
        warn("یکی از profileهای بالا را بنویسید.")
    peer_role = "client" if role == "server" else "server"
    while True:
        peer = ask(f"IPv4 واقعی {peer_role}")
        if valid_ipv4(peer):
            break
        warn("یک IPv4 یک‌طرفه (unicast) بنویسید.")
    while True:
        local_ip = ask("IPv4 محلی (خالی = از مسیر)", "")
        if valid_ipv4(local_ip, allow_empty=True):
            break
        warn("IPv4 محلی نامعتبر است.")
    while True:
        interface = ask("اینترفیس (خالی = از مسیر)", "")
        if re.fullmatch(r"[A-Za-z0-9_.-]{0,15}", interface):
            break
        warn("نام اینترفیس نامعتبر است.")
    port = ask_int("پورت بیرونی (هر دو طرف یکی)", 443, 1, 65535)
    while True:
        mode = ask("IP mode (normal/spoof/dcpi)", "normal")
        if mode in ("normal", "spoof", "dcpi"):
            break
        warn("normal یا spoof یا dcpi.")
    source = ""
    dest = ""
    if mode == "spoof":
        while True:
            source = ask("spoof_src_ip (خالی = واقعی)", "")
            dest = ask("spoof_dst_ip (خالی = همتا)", "")
            if valid_ipv4(source, allow_empty=True) and valid_ipv4(dest, allow_empty=True):
                break
            warn("آدرس spoof باید IPv4 یک‌طرفه باشد.")
    raw = {
        "profile": profile,
        "peer_ip": peer,
        "l4_port": port,
        "dcpi_mode": mode == "dcpi",
    }
    if local_ip:
        raw["local_ip"] = local_ip
    if interface:
        raw["interface"] = interface
    if source:
        raw["spoof_src_ip"] = source
    if dest:
        raw["spoof_dst_ip"] = dest
    return raw


def carrier_fields(role: str, transport: str, reverse: bool) -> dict:
    fields = {"transport": transport}
    authority = ""
    if transport in HTTP_FAMILY:
        fields["http_path"] = ask_http_path()
    if transport in ("xhttp", "xhttps"):
        xhttp = ask_xhttp(role, reverse)
        authority = str(xhttp.get("host", ""))
        fields["xhttp"] = xhttp
    if transport in TLS_TRANSPORTS:
        fields.update(ask_tls(role, transport, reverse, authority))
    if transport in RAW_TRANSPORTS:
        fields["raw"] = ask_raw(role)
    return fields


def ask_forwarding(transport: str) -> str:
    default = "tun" if transport == "tun" else "ports"
    print("  forwarding: ports (فوروارد پورت)  tun  tun+ports")
    while True:
        mode = ask("forwarding", default)
        if mode not in ("ports", "tun", "tun+ports"):
            warn("ports یا tun یا tun+ports.")
            continue
        if transport == "tun" and mode == "ports":
            warn("حامل tun فقط با tun یا tun+ports کار می‌کند.")
            continue
        return mode


def valid_tun_ip(value: str) -> bool:
    try:
        address = ipaddress.ip_address(value)
    except ValueError:
        return False
    return not address.is_unspecified and not address.is_multicast


def ask_tun(role: str, forwarding: str) -> dict:
    while True:
        name = ask("نام اینترفیس tun", "dagger0")
        if re.fullmatch(r"[A-Za-z0-9_-]{1,15}", name):
            break
        warn("نام tun باید ۱ تا ۱۵ حرف، عدد، _ یا - باشد.")
    if role == "server":
        default_ip, default_peer = "10.77.0.1", "10.77.0.2"
    else:
        default_ip, default_peer = "10.77.0.2", "10.77.0.1"
    while True:
        local_ip = ask("IP محلی tun (بدون prefix)", default_ip)
        peer_ip = ask("IP همتای tun (بدون prefix)", default_peer)
        if not valid_tun_ip(local_ip) or not valid_tun_ip(peer_ip):
            warn("دو IP واقعی و غیر multicast بنویسید.")
            continue
        left = ipaddress.ip_address(local_ip)
        right = ipaddress.ip_address(peer_ip)
        if left.version != right.version or left == right:
            warn("دو آدرس باید هم‌خانواده و متفاوت باشند.")
            continue
        if forwarding == "tun+ports" and (left.is_loopback or right.is_loopback):
            warn("با tun+ports آدرس loopback قبول نمی‌شود.")
            continue
        break
    low = 1280 if ipaddress.ip_address(local_ip).version == 6 else 576
    mtu = ask_int("MTU", 1400 if 1400 >= low else low, low, 9000)
    tun = {
        "name": name,
        "address": local_ip,
        "peer_address": peer_ip,
        "mtu": mtu,
    }
    if forwarding == "tun+ports":
        tun["forwarding_port"] = ask_int("tun.forwarding_port (هر دو طرف یکی)", 47475, 1024, 65535)
        print("  map و socks از روی همین پورت داخلی tun رد می‌شوند.")
    else:
        print("  این حالت فقط بسته IP را رد می‌کند. map جدا لازم ندارد.")
    return tun


def address_choice(role: str, transport: str, reverse: bool):
    ipv6 = transport == "dc6"
    if reverse:
        if role == "server":
            default = "[::1]:7000" if ipv6 else "127.0.0.1:7000"
            return "آدرس dial به HTTP edge (addr)", default, False, ipv6
        default = "[::]:7000" if ipv6 else "0.0.0.0:7000"
        return "آدرس listen مبدأ HTTP (addr)", default, True, ipv6
    if role == "server":
        default = "[::]:7000" if ipv6 else "0.0.0.0:7000"
        return "آدرس listen تونل (addr)", default, True, ipv6
    default = "[::1]:7000" if ipv6 else "127.0.0.1:7000"
    return "آدرس dial سرور (addr)", default, False, ipv6


def ask_maps() -> list:
    maps = []
    if not ask_yes("افزودن port map", True):
        return maps
    while True:
        while True:
            kind = ask("نوع map (tcp/udp)", "tcp").lower()
            if kind in ("tcp", "udp"):
                break
            warn("tcp یا udp.")
        if kind == "tcp":
            bind_default, target_default = "127.0.0.1:18080", "127.0.0.1:8080"
        else:
            bind_default, target_default = "127.0.0.1:15353", "127.0.0.1:5353"
        bind = ask_addr("bind", bind_default, bind=True, ipv6=False)
        target = ask_addr("target", target_default, bind=False, ipv6=False)
        maps.append({"type": kind, "bind": bind, "target": target})
        if not ask_yes("map دیگر", False):
            return maps


def ask_socks(required: bool) -> str:
