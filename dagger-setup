def systemctl(args: list[str]) -> int:
    binary = shutil.which("systemctl")
    if binary is None:
        warn("systemctl پیدا نشد.")
        return 1
    command = [binary]
    if not is_root():
        command.append("--user")
    command.extend(args)
    return subprocess.run(command).returncode


