        "7": lambda: service_action("restart"),
        "8": lambda: service_action("stop"),
        "9": lambda: service_action("logs"),
        "10": do_cert,
        "11": do_linktest,
    }
    action = actions.get(choice)
    if action is None:
        return
    open_form(titles.get(choice, "dagger-rs"))
    try:
        action()
    except Exception as exc:
        warn(f"خطا: {exc}")
        pause()


def menu_loop() -> int:
    ids = selectable_ids()
    index = 0
    notice = ""
    while True:
        draw_menu(ids[index], notice)
        key = read_key()
        notice = ""
        if key in ("eof", "exit"):
            return 0
        if key == "up":
            index = (index - 1) % len(ids)
        elif key == "down":
            index = (index + 1) % len(ids)
        elif key == "enter":
            if ids[index] == "0":
                return 0
            dispatch(ids[index])
        elif key.startswith("run:"):
            choice = key.split(":", 1)[1]
            if choice == "0":
                return 0
            if choice in ids:
                index = ids.index(choice)
                dispatch(choice)
        elif key.startswith("num:"):
            choice = key.split(":", 1)[1]
            if choice in ids:
                index = ids.index(choice)
            else:
                notice = "شماره نامعتبر است."
        elif key == "bad":
            notice = "از ↑↓ یا شماره ۰ تا ۱۱ استفاده کنید."


def open_terminal_fd():
    try:
        return os.open("/dev/tty", os.O_RDWR)
    except OSError:
        pass
    stdin = sys.stdin
    isatty = getattr(stdin, "isatty", None)
    if isatty is not None and isatty():
        return stdin.fileno()
    return None


def attach_output(fd: int) -> None:
    cloned = os.dup(fd)
    sys.stdout = os.fdopen(
        cloned,
        "w",
        encoding="utf-8",
        errors="replace",
        buffering=1,
        closefd=True,
    )


def main(argv: list[str] | None = None) -> int:
    global FD, ORIG, BINARY, CONFIG
    configure_stdio()
    args = list(sys.argv[1:] if argv is None else argv)
    if args and args[0] in ("-h", "--help"):
        print("Usage: dagger-setup")
        print("Full-screen dagger-rs setup. Keys are read from /dev/tty.")
        print("Override DAGGER_BIN and DAGGER_CONFIG_DIR for a local directory.")
        return 0
    if args:
        print("این برنامه منوی تعاملی است و گزینه خط فرمان ندارد.", file=sys.stderr)
        return 2
    fd = open_terminal_fd()
    if fd is None:
        print("ترمینال وصل نیست. منو را با این دستور باز کنید: sudo dagger-setup")
        return 0
    try:
        import termios
    except ImportError:
        print("این منو به ترمینال لینوکس نیاز دارد.", file=sys.stderr)
        return 1
    FD = fd
    ORIG = termios.tcgetattr(FD)
    attach_output(FD)
    BINARY = find_binary()
    CONFIG = prepare_config_dir()
    try:
        enter_screen()
        return menu_loop()
    finally:
        leave_screen()


if __name__ == "__main__":
    raise SystemExit(main())
