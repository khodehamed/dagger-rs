def is_root() -> bool:
    geteuid = getattr(os, "geteuid", None)
    return bool(geteuid and geteuid() == 0)


def assert_safe(path: Path) -> None:
    text = str(path)
    if re.search(r"[\x00-\x1f]", text) or any(char in text for char in '"%$'):
        print("Path contains a forbidden character.", file=sys.stderr)
        raise SystemExit(2)


def default_config_dir() -> Path:
    env = os.environ.get("DAGGER_CONFIG_DIR")
    if env:
        return Path(env)
    if is_root():
        return Path("/etc/dagger-rs")
    xdg = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg) if xdg else Path.home() / ".config"
    return base / "dagger-rs"


def prepare_config_dir() -> Path:
    path = default_config_dir().expanduser().resolve()
    assert_safe(path)
    home = str(Path.home().resolve()) if Path.home().exists() else ""
    forbidden = {
        "/",
        "/etc",
        "/usr",
        "/usr/local",
        "/var",
        "/home",
        "/root",
        "/opt",
        "/tmp",
        home,
    }
    if str(path) in forbidden:
        print("Choose a dedicated directory for the config.", file=sys.stderr)
        raise SystemExit(2)
    path.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(path, 0o700)
    except OSError:
        pass
    return path


def find_binary() -> str:
    candidates = []
    env = os.environ.get("DAGGER_BIN")
    if env:
        candidates.append(env)
    else:
        found = shutil.which("dagger-rs")
        if found:
            candidates.append(found)
        candidates.append("/usr/local/bin/dagger-rs")
    for item in candidates:
        candidate = Path(item)
        if candidate.is_file():
            assert_safe(candidate)
            return str(candidate)
    print("dagger-rs was not found. Install it first.", file=sys.stderr)
    raise SystemExit(1)


def split_endpoint(value: str):
    if any(char.isspace() for char in value) or not value or len(value) > 1024:
        return None
    if value.startswith("["):
        rest = value[1:]
        if "]" not in rest:
            return None
        host, after = rest.split("]", 1)
        if not after.startswith(":") or not host:
            return None
        return host, after[1:], True
    if value.count(":") != 1:
        return None
    host, port = value.split(":", 1)
    if not host:
        return None
    return host, port, False


def valid_endpoint(value: str, bind: bool = False, ipv6: bool = False) -> bool:
    parsed = split_endpoint(value)
    if parsed is None:
        return False
    host, port, bracket = parsed
    if not port.isdigit():
        return False
    number = int(port, 10)
    if not 1 <= number <= 65535:
        return False
    if ipv6 or bracket:
        try:
            ipaddress.IPv6Address(host)
        except ValueError:
            return False
        return True
    if bind:
        try:
            ipaddress.ip_address(host)
        except ValueError:
            return False
        return True
    if re.fullmatch(r"[A-Za-z0-9.-]+", host) is None:
        return False
    if host.startswith("-") or host.endswith("-") or ".." in host:
        return False
    return True


def ask_addr(label: str, default: str, bind: bool, ipv6: bool) -> str:
    while True:
        value = ask(label, default)
        if valid_endpoint(value, bind=bind, ipv6=ipv6):
            return value
        if ipv6:
            warn("For dc6, type an address as [IPv6]:port.")
        elif bind:
            warn("Type an address as IP:port. IPv6 uses brackets: [2001:db8::1]:7000")
        else:
            warn("Type an address as host:port or [IPv6]:port.")


def valid_key(value: str) -> bool:
    return bool(re.fullmatch(r"[0-9a-fA-F]{64}", value)) and set(value.lower()) != {"0"}


def chmod_private(path: Path) -> None:
    try:
        os.chmod(path, 0o600)
    except OSError:
        pass


def run_bin(args: list[str], stdin=None) -> int:
    completed = subprocess.run([BINARY, *args], stdin=stdin)
    return completed.returncode


def ensure_keys(role: str) -> bool:
    directory = CONFIG / f"{role}-keys"
    private = directory / "private.key"
    public = directory / "public.key"
    if private.is_file():
        print(f"  {role} key already exists. Not created.")
    else:
        directory.mkdir(parents=True, exist_ok=True)
        code = run_bin(["keygen", "--out", str(directory)])
        if code != 0 or not public.is_file():
            warn("Key generation failed.")
            return False
        chmod_private(private)
    if public.is_file():
        text = public.read_text(encoding="utf-8", errors="replace").strip()
        print("  Public key (send only this to the other side):")
        print(f"  {text}")
        print("  private.key stays on this machine.")
    return public.is_file()


def place_file(src: str, dest: Path, secret: bool = False) -> bool:
    source = Path(src)
    if not source.is_file():
        return False
    dest.parent.mkdir(parents=True, exist_ok=True)
    same = dest.exists() and source.resolve() == dest.resolve()
    if not same:
        shutil.copyfile(source, dest)
    if secret:
        chmod_private(dest)
    return True


def valid_authority(value: str) -> bool:
    if not value or len(value) > 253:
        return False
    return re.fullmatch(r"(\[[0-9a-fA-F:]+\]|[A-Za-z0-9.-]+)(:[0-9]+)?", value) is not None


def authority_name(authority: str) -> str:
    if authority.startswith("["):
        return authority[1:].split("]", 1)[0]
    return authority.split(":", 1)[0]


def presents_certificate(role: str, reverse: bool) -> bool:
    if reverse:
        return role == "client"
    return role == "server"


def ask_transport() -> str:
    options = [(name, name) for name in TRANSPORTS]
    return choose(
        "Transport",
        options,
        default=0,
        preamble="Enter keeps tcp.",
    )


def ask_http_path() -> str:
    while True:
        path = ask("http_path", "/tunnel")
        if re.fullmatch(r"/[A-Za-z0-9_./~-]*", path):
            return path
        warn("The path must start with / and use only simple characters.")


def ask_xhttp(role: str, reverse: bool) -> dict:
    default_mode = "packet-up" if reverse else "stream-up"
    if reverse:
        if role == "server":
            print("  This logical server dials the HTTP edge. maps and socks stay here.")
        else:
            print("  This logical client listens as the origin. allowed_targets stay here.")
    modes = [("stream-up", "stream-up"), ("packet-up", "packet-up"), ("auto", "auto")]
    mode = choose(
        "xhttp mode",
        modes,
        default=modes.index((default_mode, default_mode)),
        preamble="Enter keeps the highlighted mode.",
    )
    options = {"mode": mode}
    dialer = (role == "client" and not reverse) or (role == "server" and reverse)
    if dialer:
        while True:
            host = ask("HTTP Host / TLS SNI (empty = peer address)", "")
            if host and not valid_authority(host):
                warn("Type a hostname or IP, optionally with a port.")
                continue
            if reverse and not host:
                warn("Reverse needs the domain name that reaches the origin.")
                continue
            if host:
                options["host"] = host
            break
    return options


def ask_tls(role: str, transport: str, reverse: bool, authority: str) -> dict:
    directory = CONFIG / f"{role}-tls"
    directory.mkdir(parents=True, exist_ok=True)
    fields = {}
    if presents_certificate(role, reverse):
        how = choose(
            "TLS certificate",
            [
                ("generate", "Generate a local certificate"),
                ("files", "Use PEM files I already have"),
            ],
            default=0,
            preamble="Enter generates cert.pem and key.pem in the config directory.",
        )
        if how == "generate":
            while True:
                name = ask("Certificate name", "localhost")
                if re.fullmatch(r"[A-Za-z0-9_.:-]+", name or ""):
                    break
                warn("Certificate name is invalid.")
            code = run_bin(["certgen", "--out", str(directory), "--name", name])
            if code != 0 or not (directory / "cert.pem").is_file() or not (directory / "key.pem").is_file():
                warn("Certificate generation failed. Choose existing PEM files.")
                how = "files"
        if how == "generate":
            fields["cert_file"] = f"{role}-tls/cert.pem"
            fields["key_file"] = f"{role}-tls/key.pem"
            return fields
        while True:
            certificate = ask("Server cert.pem file")
            key = ask("Server key.pem file")
            if place_file(certificate, directory / "cert.pem") and place_file(
                key, directory / "key.pem", secret=True
            ):
                break
            warn("Both PEM files must exist.")
        fields["cert_file"] = f"{role}-tls/cert.pem"
        fields["key_file"] = f"{role}-tls/key.pem"
        return fields
    if transport == "xhttps" and authority:
        name = authority_name(authority)
        print(f"  TLS name is taken from Host: {name}")
    else:
        while True:
            name = ask("TLS server_name (certificate name)")
            if re.fullmatch(r"[A-Za-z0-9_.:-]+", name or ""):
                break
            warn("TLS name is invalid.")
    while True:
        certificate = ask("Trust PEM file (ca_file)")
        if place_file(certificate, directory / "ca.pem"):
            break
        warn("Trust certificate file was not found.")
    fields["server_name"] = name
    fields["ca_file"] = f"{role}-tls/ca.pem"
    return fields


def valid_ipv4(value: str, allow_empty: bool = False) -> bool:
    if value == "":
        return allow_empty
    try:
        address = ipaddress.IPv4Address(value)
    except ValueError:
        return False
    if address.is_unspecified or address.is_multicast or int(address) == 0xFFFFFFFF:
        return False
    return True


def ask_raw(role: str) -> dict:
    profiles = ["tcp", "udp", "icmp", "gre", "ipip", "bip", "raw"]
    profile = choose(
        "Raw profile",
        [(name, name) for name in profiles],
        default=0,
        preamble="Real peer, interface, and outer port. Enter keeps tcp.",
    )
    peer_role = "client" if role == "server" else "server"
    while True:
        peer = ask(f"Real {peer_role} IPv4")
        if valid_ipv4(peer):
            break
        warn("Type a unicast IPv4 address.")
    while True:
        local_ip = ask("Local IPv4 (empty = from the route)", "")
        if valid_ipv4(local_ip, allow_empty=True):
            break
        warn("Local IPv4 is invalid.")
    while True:
        interface = ask("Interface (empty = from the route)", "")
        if re.fullmatch(r"[A-Za-z0-9_.-]{0,15}", interface):
            break
        warn("Interface name is invalid.")
    port = ask_int("Outer port (same on both sides)", 443, 1, 65535)
    mode = choose(
        "IP mode",
        [("normal", "normal"), ("spoof", "spoof"), ("dcpi", "dcpi")],
        default=0,
        preamble="Enter keeps normal.",
    )
    source = ""
    dest = ""
    if mode == "spoof":
        while True:
            source = ask("spoof_src_ip (empty = real)", "")
            dest = ask("spoof_dst_ip (empty = peer)", "")
            if valid_ipv4(source, allow_empty=True) and valid_ipv4(dest, allow_empty=True):
                break
            warn("Spoof addresses must be unicast IPv4.")
    raw = {
        "profile": profile,
        "peer_ip": peer,
        "l4_port": port,
        "dcpi_mode": mode == "dcpi",
    }
    if local_ip:
        raw["local_ip"] = local_ip
    if interface:
        raw["interface"] = interface
    if source:
        raw["spoof_src_ip"] = source
    if dest:
        raw["spoof_dst_ip"] = dest
    return raw


def carrier_fields(role: str, transport: str, reverse: bool) -> dict:
    fields = {"transport": transport}
    authority = ""
    if transport in HTTP_FAMILY:
        fields["http_path"] = ask_http_path()
    if transport in ("xhttp", "xhttps"):
        xhttp = ask_xhttp(role, reverse)
        authority = str(xhttp.get("host", ""))
        fields["xhttp"] = xhttp
    if transport in TLS_TRANSPORTS:
        fields.update(ask_tls(role, transport, reverse, authority))
    if transport in RAW_TRANSPORTS:
        fields["raw"] = ask_raw(role)
    return fields


