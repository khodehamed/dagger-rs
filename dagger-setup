def do_linktest() -> None:
    action = choose(
        "Link test",
        [("probe", "Probe the peer"), ("listen", "Wait for a peer")],
        default=0,
        preamble="Uses only the peer and port you enter next. Enter probes.",
    )
    args = ["linktest", action]
    if action == "listen":
        bind = ask_addr("Local bind", "127.0.0.1:47000", bind=True, ipv6=False)
        peer = ask_ip("Expected peer IP")
        wait = ask_int("Listen time in seconds", 900, 1, 86400)
        args += ["--bind", bind, "--peer", peer, "--wait-secs", str(wait)]
    else:
        peer = ask_addr("Peer address ip:port", "127.0.0.1:47000", bind=True, ipv6=False)
        while True:
            source = ask("Local source IP (empty = default route)", "")
            if source == "":
                break
            try:
                ipaddress.ip_address(source)
            except ValueError:
                warn("Source IP is invalid.")
                continue
            break
        local_port = ask_int("Return port (0 = any)", 0, 0, 65535)
        seconds = ask_int("Throughput time in seconds", 4, 1, 3600)
        quick = ask_yes("Quick test", True)
        args += ["--peer", peer, "--local-port", str(local_port), "--seconds", str(seconds)]
        if source:
            args += ["--bind", source]
        if quick:
            args.append("--quick")
    extra = ask_ports()
    if extra:
        args += ["--extra-ports", extra]
    run_bin(args)
    pause()


def file_state(name: str) -> str:
    return "present" if (CONFIG / name).is_file() else "missing"


def title_bar() -> str:
    left = " dagger-rs"
    right = "Tunnel setup "
    gap = WIDTH - len(left) - len(right)
    text = left + (" " * max(gap, 1)) + right
    text = fit(text, WIDTH)
    return HEAD + text + " " * (WIDTH - len(text)) + RESET + "\n"


def meta_line() -> str:
    path = fit(str(CONFIG), 28)
    server = file_state("server.json")
    client = file_state("client.json")
    parts = [
        (f" {path}  ", DIM),
        ("server.json ", ""),
        (server, OK if server == "present" else DIM),
        ("   client.json ", ""),
        (client, OK if client == "present" else DIM),
    ]
    visible = "".join(text for text, _color in parts)
    if len(visible) > WIDTH:
        visible = fit(visible, WIDTH)
        return DIM + visible + " " * (WIDTH - len(visible)) + RESET + "\n"
    body = []
    for text, color in parts:
        body.append(f"{color}{text}{RESET}" if color else text)
    return "".join(body) + " " * (WIDTH - len(visible)) + "\n"


def box_row(text: str, fill: str = "") -> str:
    shown = fit(text, INNER)
    pad = INNER - len(shown)
    if fill:
        inner = f"{fill}{shown}{' ' * pad}{RESET}"
    else:
        inner = shown + " " * pad
    return f"{BOX}│{RESET}{inner}{BOX}│{RESET}\n"


def draw_menu(selected: str, notice: str) -> None:
    lines = ["\033[2J\033[H\033[?25l", title_bar(), meta_line()]
    lines.append(f"{BOX}┌{'─' * INNER}┐{RESET}\n")
    for kind, ident, label in MENU_ROWS:
        if kind == "sec":
            lines.append(box_row("  " + label, SEC))
            continue
        mark = "▸ " if ident == selected else "  "
        if ident == selected:
            lines.append(box_row(mark + label, SEL))
        else:
            lines.append(box_row(mark + label))
    lines.append(f"{BOX}└{'─' * INNER}┘{RESET}\n")
    hint = fit("  ↑↓ move     Enter select     0 exit", WIDTH)
    lines.append(DIM + hint + RESET + "\n")
    if notice:
        note = fit("  " + notice, WIDTH)
        lines.append(ERR + note + RESET + "\n")
    else:
        lines.append("\n")
    emit("".join(lines))


def read_key() -> str:
    cbreak()
    try:
        first = take_available(1)
        if first == b"":
            return "eof"
        if first in (b"\r", b"\n"):
            return "enter"
        if first == b"\x1b":
            sequence = b""
            while wait_input(0.05):
                more = take_available(8)
                if not more:
                    break
                sequence += more
                if len(sequence) >= 6:
                    break
            if sequence.startswith(b"[A") or sequence.startswith(b"OA"):
                return "up"
            if sequence.startswith(b"[B") or sequence.startswith(b"OB"):
                return "down"
            return "ignore"
        if first in b"0123456789":
            digit = first.decode()
            if digit == "1" and wait_input(0.35):
                nxt = take_available(1)
                if nxt in (b"0", b"1", b"2", b"3"):
                    return "num:" + digit + nxt.decode()
                if nxt in (b"\r", b"\n"):
                    return "run:1"
            if digit == "0":
                return "exit"
            return "num:" + digit
        return "bad"
    finally:
        try:
            cooked()
        except Exception:
            pass


def selectable_ids() -> list[str]:
    return [ident for kind, ident, _label in MENU_ROWS if kind == "item"]


def dispatch(choice: str) -> None:
    titles = {
        "1": "Public key",
        "2": "Configure server or client",
        "3": "dagger-rs --check",
        "4": "Run in the foreground",
        "5": "Install and start systemd",
        "6": "Service status",
        "7": "Restart",
        "8": "Stop the service",
        "9": "Recent logs",
        "10": "TLS certificate",
        "11": "Link test",
    }
    actions = {
        "1": do_keys,
        "2": configure,
        "3": do_check,
        "4": do_foreground,
        "5": install_service,
        "6": lambda: service_action("status"),
        "7": lambda: service_action("restart"),
        "8": lambda: service_action("stop"),
        "9": lambda: service_action("logs"),
        "10": do_cert,
        "11": do_linktest,
    }
    action = actions.get(choice)
    if action is None:
        return
    open_form(titles.get(choice, "dagger-rs"))
    try:
        action()
    except Exception as exc:
        warn(f"Error: {exc}")
        pause()


def menu_loop() -> int:
    ids = selectable_ids()
    index = 0
    notice = ""
    while True:
        draw_menu(ids[index], notice)
        key = read_key()
        notice = ""
        if key in ("eof", "exit"):
            return 0
        if key == "up":
            index = (index - 1) % len(ids)
        elif key == "down":
            index = (index + 1) % len(ids)
        elif key == "enter":
            if ids[index] == "0":
                return 0
            dispatch(ids[index])
        elif key.startswith("run:"):
            choice = key.split(":", 1)[1]
            if choice == "0":
                return 0
            if choice in ids:
                index = ids.index(choice)
                dispatch(choice)
        elif key.startswith("num:"):
            choice = key.split(":", 1)[1]
            if choice in ids:
                index = ids.index(choice)
            else:
                notice = "That number is not on the menu."
        elif key == "bad":
            notice = "Use ↑↓ or a number from 0 to 11."


def open_terminal_fd():
    try:
        return os.open("/dev/tty", os.O_RDWR)
    except OSError:
        pass
    stdin = sys.stdin
    isatty = getattr(stdin, "isatty", None)
    if isatty is not None and isatty():
        return stdin.fileno()
    return None


def attach_output(fd: int) -> None:
    cloned = os.dup(fd)
    sys.stdout = os.fdopen(
        cloned,
        "w",
        encoding="utf-8",
        errors="replace",
        buffering=1,
        closefd=True,
    )


def main(argv: list[str] | None = None) -> int:
    global FD, ORIG, BINARY, CONFIG
    configure_stdio()
    args = list(sys.argv[1:] if argv is None else argv)
    if args and args[0] in ("-h", "--help"):
        print("Usage: dagger-setup")
        print("Full-screen dagger-rs setup. Keys are read from /dev/tty.")
        print("Override DAGGER_BIN and DAGGER_CONFIG_DIR for a local directory.")
        return 0
    if args:
        print("This program is an interactive menu and takes no command-line options.", file=sys.stderr)
        return 2
    fd = open_terminal_fd()
    if fd is None:
        print("No terminal attached. Open the menu with: sudo dagger-setup")
        return 0
    try:
        import termios
    except ImportError:
        print("This menu needs a Linux terminal.", file=sys.stderr)
        return 1
    FD = fd
    ORIG = termios.tcgetattr(FD)
    attach_output(FD)
    BINARY = find_binary()
    CONFIG = prepare_config_dir()
    try:
        enter_screen()
        return menu_loop()
    finally:
        leave_screen()


if __name__ == "__main__":
    raise SystemExit(main())
