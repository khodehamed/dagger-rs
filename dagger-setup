def valid_tun_ip(value: str) -> bool:
    try:
        address = ipaddress.ip_address(value)
    except ValueError:
        return False
    return not address.is_unspecified and not address.is_multicast


def ask_tun(role: str, forwarding: str) -> dict:
    while True:
        name = ask("tun interface name", "dagger0")
        if re.fullmatch(r"[A-Za-z0-9_-]{1,15}", name):
            break
        warn("The tun name must be 1 to 15 letters, digits, _ or -.")
    if role == "server":
        default_ip, default_peer = "10.77.0.1", "10.77.0.2"
    else:
        default_ip, default_peer = "10.77.0.2", "10.77.0.1"
    while True:
        local_ip = ask("Local tun IP (no prefix)", default_ip)
        peer_ip = ask("Peer tun IP (no prefix)", default_peer)
        if not valid_tun_ip(local_ip) or not valid_tun_ip(peer_ip):
            warn("Type two real, non-multicast IP addresses.")
            continue
        left = ipaddress.ip_address(local_ip)
        right = ipaddress.ip_address(peer_ip)
        if left.version != right.version or left == right:
            warn("The two addresses must be the same family and different.")
            continue
        if forwarding == "tun+ports" and (left.is_loopback or right.is_loopback):
            warn("tun+ports does not accept a loopback address.")
            continue
        break
    low = 1280 if ipaddress.ip_address(local_ip).version == 6 else 576
    mtu = ask_int("MTU", 1400 if 1400 >= low else low, low, 9000)
    tun = {
        "name": name,
        "address": local_ip,
        "peer_address": peer_ip,
        "mtu": mtu,
    }
    if forwarding == "tun+ports":
        tun["forwarding_port"] = ask_int("tun.forwarding_port (same on both sides)", 47475, 1024, 65535)
        print("  maps and socks go through this internal tun port.")
    else:
        print("  This mode only forwards IP packets. No separate map is needed.")
    return tun


def address_choice(role: str, transport: str, reverse: bool):
    ipv6 = transport == "dc6"
    if reverse:
        if role == "server":
            default = "[::1]:7000" if ipv6 else "127.0.0.1:7000"
            return "HTTP edge address", default, False, ipv6
        default = "[::]:7000" if ipv6 else "0.0.0.0:7000"
        return "HTTP origin listen address", default, True, ipv6
    if role == "server":
        default = "[::]:7000" if ipv6 else "0.0.0.0:7000"
        return "Listen address", default, True, ipv6
    default = "[::1]:7000" if ipv6 else "127.0.0.1:7000"
    return "Server address", default, False, ipv6


DEFAULT_FORWARD_PORTS = (443, 2053, 8443, 2083, 2087, 2096)


def default_tcp_maps() -> list:
    return [
        {"type": "tcp", "bind": f"0.0.0.0:{port}", "target": f"127.0.0.1:{port}"}
        for port in DEFAULT_FORWARD_PORTS
    ]


def default_targets() -> list:
    return [f"127.0.0.1:{port}" for port in DEFAULT_FORWARD_PORTS]


def ask_one_map(kind: str) -> dict:
    if kind == "tcp":
        bind_default, target_default = "0.0.0.0:443", "127.0.0.1:443"
    else:
        bind_default, target_default = "0.0.0.0:15353", "127.0.0.1:5353"
    bind = ask_addr("Public address", bind_default, bind=True, ipv6=False)
    target = ask_addr("Service address", target_default, bind=False, ipv6=False)
    return {"type": kind, "bind": bind, "target": target}


def ask_port_numbers() -> dict:
    public = ask_int("Public port on 0.0.0.0", 443, 1, 65535)
    service = ask_int("Service port on 127.0.0.1", 443, 1, 65535)
    return {"type": "tcp", "bind": f"0.0.0.0:{public}", "target": f"127.0.0.1:{service}"}


def ask_maps() -> list:
    kind = choose(
        "Port map",
        [
            ("default", "TCP one-to-one 443, 2053, 8443, 2083, 2087, 2096"),
            ("ports", "TCP, change the two ports"),
            ("custom", "TCP, type both addresses"),
            ("udp", "UDP map"),
            ("several", "More than one map"),
            ("none", "No port map"),
        ],
        default=0,
        preamble="Enter forwards these ports one-to-one to 127.0.0.1.\n443, 2053, 8443, 2083, 2087, 2096. The tunnel listener stays on 7000.",
    )
    if kind == "default":
        return default_tcp_maps()
    if kind == "none":
        return []
    if kind == "ports":
        return [ask_port_numbers()]
    if kind == "custom":
        return [ask_one_map("tcp")]
    if kind == "udp":
        return [ask_one_map("udp")]
    maps = []
    while True:
        step = choose(
            "Add a map",
            [
                ("tcp", "TCP, type both addresses"),
                ("udp", "UDP, type both addresses"),
                ("done", "Done"),
            ],
            default=0 if not maps else 2,
            preamble="Enter adds a TCP map until you choose Done.",
        )
        if step == "done":
            return maps
        maps.append(ask_one_map(step))


def ask_socks(required: bool) -> str:
    if not required:
        enabled = choose(
            "SOCKS proxy",
            [(False, "Off"), (True, "On, 127.0.0.1:1080")],
            default=0,
            preamble="Enter leaves SOCKS off.",
        )
        if not enabled:
            return ""
    else:
        emit("  No port map, so a SOCKS address is required.\n")
    while True:
        value = ask("SOCKS address", "127.0.0.1:1080")
        if valid_endpoint(value, bind=True):
            return value
        warn("Type a SOCKS address as 127.0.0.1:1080.")


def ask_targets() -> list:
    scope = choose(
        "Destinations",
        [
            ("map", "127.0.0.1 on 443, 2053, 8443, 2083, 2087, 2096"),
            ("other", "A different service address"),
            ("any", "Any destination (*)"),
        ],
        default=0,
        preamble="Enter allows the six default forwarded ports.",
    )
    if scope == "map":
        return default_targets()
    if scope == "any":
        return ["*"]
    targets = []
    while True:
        default = "127.0.0.1:443" if not targets else None
        value = ask("Service address", default)
        if value != "*" and not valid_endpoint(value, bind=False):
            warn("Type a destination like 127.0.0.1:443.")
            continue
        targets.append(value)
        if not choose_yes("Add another service address?", False):
            return targets


def pool_value(role: str, transport: str, reverse: bool, forwarding: str) -> int:
    client_pool = role == "client" or (role == "server" and reverse)
    must_be_one = (
        forwarding != "ports"
        or transport in RAW_TRANSPORTS
        or (role == "client" and reverse)
    )
    if not client_pool or must_be_one:
        print("  connection_pool: 1")
        if role == "server" and not reverse:
            print("  Set the pool size on the client.")
        return 1
    return ask_int("connection_pool", 1, 1, 16)


def show_summary(config: dict) -> str:
    lines = ["Enter saves this config."]
    lines.append(f"mode: {config['mode']}")
    lines.append(f"reverse: {str(config.get('reverse', False)).lower()}")
    if config["mode"] == "server":
        listener = config["listeners"][0]
        lines.append(f"transport: {listener.get('transport', 'tcp')}")
        lines.append(f"addr: {listener['addr']}")
        lines.append(f"connection_pool: {listener.get('connection_pool', 1)}")
        for item in listener.get("maps", []):
            lines.append(f"map {item['type']}: {item['bind']} -> {item['target']}")
        if config.get("socks5"):
            lines.append(f"socks5: {config['socks5']}")
        lines.append(f"peer_public_keys: {config['peer_public_keys'][0]}")
    else:
        path = config["paths"][0]
        lines.append(f"transport: {path.get('transport', 'tcp')}")
        lines.append(f"addr: {path['addr']}")
        lines.append(f"connection_pool: {path.get('connection_pool', 1)}")
        for target in config.get("allowed_targets", []):
            lines.append(f"allowed_targets: {target}")
        lines.append(f"server_public_key: {path['server_public_key']}")
    lines.append(f"private_key_file: {config['private_key_file']}")
    if "tun" in config:
        tun = config["tun"]
        lines.append(f"tun: {tun['name']} {tun['address']} -> {tun['peer_address']} mtu {tun['mtu']}")
        if "forwarding_port" in tun:
            lines.append(f"tun.forwarding_port: {tun['forwarding_port']}")
    return "\n".join(lines)


def write_config(role: str, config: dict) -> None:
    destination = CONFIG / f"{role}.json"
    handle, temporary_name = tempfile.mkstemp(prefix=".config.", dir=str(CONFIG))
    os.close(handle)
    temporary = Path(temporary_name)
    try:
        temporary.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
        chmod_private(temporary)
        if run_bin(["--config", str(temporary), "--check"]) != 0:
            warn("dagger-rs --check rejected this config. The previous file was kept.")
            return
        if destination.exists():
            backup = CONFIG / f"{role}.json.backup.{time.time_ns()}"
            shutil.copy2(destination, backup)
            print(f"  Previous copy: {backup.name}")
        os.replace(temporary, destination)
        temporary = None
        chmod_private(destination)
        claim_files(role, destination)
        print(f"  Saved: {destination}")
    finally:
        if temporary is not None and temporary.exists():
            temporary.unlink()


def claim_files(role: str, config_path: Path) -> None:
    if not is_root():
        return
    if shutil.which("id") is None:
        return
    probe = subprocess.run(["id", "dagger-rs"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if probe.returncode != 0:
        return
    targets = [CONFIG, config_path, CONFIG / f"{role}-keys", CONFIG / f"{role}-tls"]
    for directory in (CONFIG / f"{role}-keys", CONFIG / f"{role}-tls"):
        if not directory.is_dir():
            continue
        for name in ("private.key", "public.key", "cert.pem", "key.pem", "ca.pem"):
            item = directory / name
            if item.is_file():
                targets.append(item)
    for target in targets:
        if target.exists():
            subprocess.run(["chown", "dagger-rs:dagger-rs", str(target)])


def configure() -> None:
    role = ask_role()
    if role is None:
        return
    destination = CONFIG / f"{role}.json"
    if destination.exists():
        replace = choose(
            "Replace the existing file?",
            [(True, "Yes, replace it"), (False, "No, keep the current file")],
            default=1,
            preamble=f"{destination}\n1 replaces it. 2 or Enter keeps it.",
        )
        if not replace:
            emit("  The existing file was left unchanged.\n")
            pause()
            return
    if not ensure_keys(role):
        pause()
        return
    emit("  Send only the public key to the other side.\n")
    while True:
        peer = ask("Other side public key (64 hex)")
        if valid_key(peer):
            break
        warn("The key must be 64 hex digits and not all zeros.")
    while True:
        reverse = False
        transport = ask_transport()
        if transport in ("xhttp", "xhttps"):
            reverse = ask_yes("reverse for a CDN", False)
        elif transport == "tun":
            reverse = False
        fields = carrier_fields(role, transport, reverse)
        forwarding = ask_forwarding(transport)
        tun = ask_tun(role, forwarding) if forwarding != "ports" else None
        if transport in RAW_TRANSPORTS:
            raw = fields["raw"]
            if role == "server":
                host = raw.get("local_ip", "0.0.0.0")
                address = f"{host}:{raw['l4_port']}"
            else:
                address = f"{raw['peer_ip']}:{raw['l4_port']}"
            print(f"  addr from the raw settings: {address}")
        else:
            label, default, bind, ipv6 = address_choice(role, transport, reverse)
            print(f"  {label}")
            address = ask_addr(label, default, bind=bind, ipv6=ipv6)
        maps = []
        socks = ""
        targets = None
        if role == "server" and forwarding != "tun":
            section("port map and socks5")
            maps = ask_maps()
            socks = ask_socks(required=not maps)
        elif role == "client" and forwarding != "tun":
            section("allowed_targets")
            targets = ask_targets()
        pool = pool_value(role, transport, reverse, forwarding)
        entry = {key: value for key, value in fields.items() if not str(key).startswith("_")}
        entry["addr"] = address
        entry["connection_pool"] = pool
        config = {
            "_comment": "Dagger Rust rewrite by ir_spoof; https://t.me/ir_spoof",
            "mode": role,
            "private_key_file": f"{role}-keys/private.key",
            "reverse": reverse,
        }
        if tun is not None:
            config["tun"] = tun
        if role == "server":
            config["peer_public_keys"] = [peer]
            if maps:
                entry["maps"] = maps
            if socks:
                config["socks5"] = socks
            config["listeners"] = [entry]
        else:
            entry["server_public_key"] = peer
            if targets is not None:
                config["allowed_targets"] = targets
            config["paths"] = [entry]
        if choose(
            "Save this config?",
            [(True, "Save"), (False, "Do not save")],
            default=0,
            preamble=show_summary(config),
        ):
            write_config(role, config)
            break
        if not choose_yes("Start over?", False):
            emit("  Nothing was written.\n")
            break
    pause()


